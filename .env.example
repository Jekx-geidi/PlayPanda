# Copy this file to .env.local and fill in real values. .env.local is gitignored.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only — never reference from src/ (no VITE_ prefix, so Vite won't bundle it)
SUPABASE_SECRET_KEY=

# Google OAuth client — paste into Supabase Dashboard -> Authentication -> Providers -> Google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Custom SMTP — paste into Supabase Dashboard -> Authentication -> Emails -> SMTP Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_SENDER_NAME=PlayPanda
